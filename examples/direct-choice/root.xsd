<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:r="urn:direct-choice"
           targetNamespace="urn:direct-choice">
  <xs:import namespace="urn:direct-choice:integer" schemaLocation="integer.xsd"/>
  <xs:import namespace="urn:direct-choice:decimal" schemaLocation="decimal.xsd"/>
  <xs:complexType name="Reading">
    <xs:choice>
      <xs:element name="count" type="xs:integer"/>
      <xs:element name="amount" type="xs:decimal"/>
    </xs:choice>
  </xs:complexType>
  <xs:element name="reading" type="r:Reading"/>
</xs:schema>
